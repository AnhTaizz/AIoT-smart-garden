# For running Uvicorn on the laptop outside Docker; existing Compose sets these.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=smart_garden
DB_USER=smart_garden
DB_PASSWORD=change-me-local-development-only
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
COMMAND_TIMEOUT_SECONDS=15
COMMAND_MAX_DURATION_SECONDS=120
TELEMETRY_STALE_SECONDS=30
# Add the exact frontend HTTPS tunnel origin for cross-origin Web requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
