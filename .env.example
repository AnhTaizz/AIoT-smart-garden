# Local development only. Copy this file to .env before running Docker Compose.
COMPOSE_PROJECT_NAME=smart-garden

API_PORT=8000
FRONTEND_PORT=5173
MQTT_PORT=1883
POSTGRES_PORT=5432

# Keep /api when using Docker Compose or the Vite development proxy.
# Web keeps /api through the frontend tunnel (same-origin Nginx/Vite proxy).
# Direct Web API access may set VITE_API_URL to the current HTTPS backend tunnel.
# Capacitor builds use frontend/.env.mobile.local; never use the frontend URL.
VITE_API_BASE_URL=/api
VITE_API_URL=

# Add the exact frontend tunnel origin only if Web calls the backend directly.
# Native WebView origins for Android and iOS are included explicitly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

POSTGRES_DB=smart_garden
POSTGRES_USER=smart_garden
POSTGRES_PASSWORD=change-me-local-development-only

DB_CONNECT_TIMEOUT_SECONDS=2

# Backend command lifecycle (draft values until G02 is agreed).
# A command with no final ACK before this deadline becomes `timeout`.
COMMAND_TIMEOUT_SECONDS=15
# Backend input check only; the ESP32 still enforces its own pump limit.
COMMAND_MAX_DURATION_SECONDS=120
# Latest telemetry older than this (server receive time) is reported stale.
TELEMETRY_STALE_SECONDS=30

# Custom Kaggle chat API. Keep credentials on the backend only.
CHAT_API_URL=https://sly-series-landowner.ngrok-free.dev/v1/chat/completions
CHAT_API_KEY=
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=120
