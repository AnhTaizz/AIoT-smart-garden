{
  "version": 1,
  "author": "Smart Garden AIoT Team",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    {
      "type": "wokwi-potentiometer",
      "id": "pot_soil",
      "top": -90,
      "left": 180,
      "attrs": { "label": "Cảm biến độ ẩm đất (ADC)" }
    },
    {
      "type": "wokwi-aht20",
      "id": "aht20",
      "top": 160,
      "left": 200,
      "attrs": { "label": "AHT20 (Nhiệt độ & Độ ẩm)" }
    },
    {
      "type": "wokwi-relay-module",
      "id": "relay",
      "top": -90,
      "left": -180,
      "attrs": { "label": "Relay máy bơm" }
    },
    {
      "type": "wokwi-led",
      "id": "led_pump",
      "top": -170,
      "left": -140,
      "attrs": { "color": "green", "label": "Đèn chỉ báo bơm" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": -170,
      "left": -80,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "esp:3V3", "pot_soil:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "pot_soil:GND", "black", [ "v0" ] ],
    [ "esp:34", "pot_soil:SIG", "green", [ "v0" ] ],

    [ "esp:3V3", "aht20:VIN", "red", [ "v0" ] ],
    [ "esp:GND.2", "aht20:GND", "black", [ "v0" ] ],
    [ "esp:21", "aht20:SDA", "blue", [ "v0" ] ],
    [ "esp:22", "aht20:SCL", "yellow", [ "v0" ] ],

    [ "esp:5V", "relay:VCC", "red", [ "v0" ] ],
    [ "esp:GND.1", "relay:GND", "black", [ "v0" ] ],
    [ "esp:26", "relay:IN", "orange", [ "v0" ] ],

    [ "relay:NO", "led_pump:A", "green", [ "v0" ] ],
    [ "led_pump:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.1", "black", [ "v0" ] ],
    [ "relay:COM", "esp:5V", "red", [ "v0" ] ]
  ],
  "dependencies": {}
}
