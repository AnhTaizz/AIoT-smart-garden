# Local development only. Copy this file to .env before running Docker Compose.
COMPOSE_PROJECT_NAME=smart-garden

API_PORT=8000
FRONTEND_PORT=5173
MQTT_PORT=1883
POSTGRES_PORT=5432

# Keep /api when using Docker Compose or the Vite development proxy.
VITE_API_BASE_URL=/api

POSTGRES_DB=smart_garden
POSTGRES_USER=smart_garden
POSTGRES_PASSWORD=change-me-local-development-only

DB_CONNECT_TIMEOUT_SECONDS=2

# Backend command lifecycle (draft values until G02 is agreed).
# A command with no final ACK before this deadline becomes `timeout`.
COMMAND_TIMEOUT_SECONDS=15
# Backend input check only; the ESP32 still enforces its own pump limit.
COMMAND_MAX_DURATION_SECONDS=120
# Latest telemetry older than this (server receive time) is reported stale.
TELEMETRY_STALE_SECONDS=30
