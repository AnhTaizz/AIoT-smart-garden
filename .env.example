# Local development only. Copy this file to .env before running Docker Compose.
# Server/Docker settings only: Arduino IDE does not read this file.
# ESP32 Wi-Fi/MQTT settings: firmware/SmartGarden/config.local.h (Git-ignored).
COMPOSE_PROJECT_NAME=smart-garden

API_PORT=8000
FRONTEND_PORT=5173
MQTT_PORT=1883
# Optional compose.secure.yaml: create matching accounts in Mosquitto first.
MQTT_USERNAME=garden_backend
MQTT_PASSWORD=
POSTGRES_PORT=5432

# Keep /api when using Docker Compose or the Vite development proxy.
# Web keeps /api through the frontend hostname (same-origin Nginx/Vite proxy):
# https://garden.anhtaizz.id.vn/api (and https://anhtaizz.id.vn/api once routed).
# Capacitor builds use frontend/.env.mobile.local with the API hostname;
# never use the frontend URL there.
VITE_API_BASE_URL=/api
VITE_API_URL=

# Optional compose.tunnel.yaml: connector token of the existing Named Tunnel
# `garden-local` (Cloudflare dashboard > Networks > Tunnels). Secret: keep it
# only in .env. Never reuse the TOEIC tunnel token here.
CLOUDFLARE_TUNNEL_TOKEN=

# Same-origin Web (/api) needs no extra CORS origin, including the custom
# domains. Add an exact HTTPS frontend origin only if Web calls the API directly.
# Native WebView origins for Android and iOS are included explicitly.
# CORS is browser policy, not authentication; the API checks the bearer token.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost

POSTGRES_DB=smart_garden
POSTGRES_USER=smart_garden
POSTGRES_PASSWORD=change-me-local-development-only

DB_CONNECT_TIMEOUT_SECONDS=2

# Backend command lifecycle (draft values until G02 is agreed).
# A command with no final ACK before this deadline becomes `timeout`.
COMMAND_TIMEOUT_SECONDS=15
# Backend input check only; the ESP32 still enforces its own pump limit.
COMMAND_MAX_DURATION_SECONDS=120
# Latest telemetry older than this (server receive time) is reported stale.
TELEMETRY_STALE_SECONDS=30

# Physical ESP32 AUTO: comma-separated device IDs, e.g. node_01, set only for a
# supervised session after calibration/OFF checks (docs/ESP32_REAL_SETUP.md).
# Empty keeps real-device AUTO locked; simulator remains available on other IDs.
# Also requires compose.secure.yaml and private broker credentials.
IRRIGATION_REAL_DEVICE_IDS=

# Custom Kaggle chat API. Keep credentials on the backend only.
# Leave empty until the Kaggle/ngrok session is running; /chat then answers
# 503 chat_unavailable (reason not_configured). Quick URLs change per session.
CHAT_API_URL=
CHAT_API_KEY=
CHAT_TEMPERATURE=0.7
CHAT_MAX_TOKENS=1024
CHAT_TIMEOUT_SECONDS=120

# Open-Meteo forecast (W3, PROPOSED contract). Read-only advisory for the
# dashboard, chatbot and AI supervisor; never sends pump commands. Set the
# garden's own coordinates; empty coordinates keep it disabled.
# Free non-commercial use: https://open-meteo.com/en/terms
WEATHER_ENABLED=false
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
# Provider calls happen only on this schedule (min 600 s), never per request.
WEATHER_REFRESH_SECONDS=1800
# Older forecasts are shown as stale and are not used to delay watering.
WEATHER_MAX_AGE_SECONDS=7200
WEATHER_TIMEOUT_SECONDS=10

# Operator account (BC-02). Never commit real values. Generate the hash with:
#   docker compose run --rm --no-deps backend python -m app.auth hash-password
# Paste the printed scrypt:... line below. Empty/invalid => nobody can log in.
OPERATOR_USERNAME=
OPERATOR_PASSWORD_HASH=
# operator = monitor + pump control; viewer = monitor only (commands get 403).
OPERATOR_ROLE=operator
# Sessions expire after this many seconds; then the user must log in again.
AUTH_SESSION_TTL_SECONDS=28800
# Per-process in-memory limits (reset on backend restart).
LOGIN_MAX_FAILURES=5
LOGIN_FAILURE_WINDOW_SECONDS=300
# Password checks (scrypt, ~128 MiB each) allowed at once; extra logins get 429.
LOGIN_MAX_CONCURRENT=2
CHAT_RATE_LIMIT=5
CHAT_RATE_WINDOW_SECONDS=60
# pump_on per device; pump_off is never limited.
PUMP_ON_RATE_LIMIT=6
PUMP_ON_RATE_WINDOW_SECONDS=60
