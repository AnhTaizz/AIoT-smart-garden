# Web default: same-origin proxy through the frontend tunnel, no random URL needed.
VITE_API_BASE_URL=/api
# Optional direct backend HTTPS URL; overrides VITE_API_BASE_URL if non-empty.
VITE_API_URL=

# Optional local-only convenience for Vite development. Keep credentials in
# ignored .env.local, never commit them, and do not enable this outside localhost.
# VITE_DEMO_AUTO_LOGIN=true
# VITE_DEMO_USERNAME=
# VITE_DEMO_PASSWORD=
