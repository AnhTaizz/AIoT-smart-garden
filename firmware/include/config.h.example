#ifndef CONFIG_H
#define CONFIG_H

// ============================================================================
// CẤU HÌNH HỆ THỐNG SMART GARDEN FIRMWARE (ESP32)
// Sao chép file này thành include/config.h và cập nhật thông số thực tế của bạn.
// ============================================================================

// 1. Cấu hình Wi-Fi
// Trên Wokwi: sử dụng SSID "Wokwi-GUEST", mật khẩu để trống ""
// Trên phần cứng thật: điền SSID và Mật khẩu Wi-Fi hoặc Hotspot của bạn
#define WIFI_SSID             "Wokwi-GUEST"
#define WIFI_PASSWORD         ""

// 2. Cấu hình MQTT Broker
// Cung cấp địa chỉ IP LAN của Laptop chạy Mosquitto (ví dụ: "192.168.1.100")
// Hoặc sử dụng Public Broker test: "broker.emqx.io"
#define MQTT_BROKER_HOST      "192.168.1.100"
#define MQTT_BROKER_PORT      1883
#define MQTT_USERNAME         ""
#define MQTT_PASSWORD         ""

// 3. Định danh trạm (Device ID)
// Phải khớp với topic MQTT quy định trong INTERFACES.md: garden/<DEVICE_ID>/...
#define DEVICE_ID             "node_01"

// Cờ dữ liệu mô phỏng: đặt true nếu chạy trên Wokwi, đặt false trên mạch thật
#define IS_SIMULATED          false

// 4. Cấu hình Chân cắm phần cứng (GPIO Pins)
#define PIN_I2C_SDA           21    // Chân I2C SDA cho cảm biến AHT20
#define PIN_I2C_SCL           22    // Chân I2C SCL cho cảm biến AHT20
#define PIN_SOIL_ADC          34    // Chân Analog ADC đọc cảm biến độ ẩm đất
#define PIN_RELAY             26    // Chân Digital điều khiển Relay máy bơm

// Cực kích hoạt của Relay:
// - Đa số module Relay trên thị trường là kích mức THẤP (Active LOW): LOW = Bật bơm, HIGH = Tắt bơm
// - Nếu module của bạn kích mức CAO (Active HIGH): đặt HIGH = Bật bơm, LOW = Tắt bơm
#define RELAY_ACTIVE_LEVEL    LOW

// 5. Hiệu chuẩn Cảm biến độ ẩm đất (Capacitive Soil Moisture v1.2)
// Giá trị ADC (12-bit, 0..4095) trên chân ESP32:
// - SOIL_ADC_DRY: Giá trị khi cảm biến để ngoài không khí khô (thường khoảng 3000..3400)
// - SOIL_ADC_WET: Giá trị khi cảm biến nhúng vào cốc nước (thường khoảng 1300..1600)
#define SOIL_ADC_DRY          3200
#define SOIL_ADC_WET          1400

// 6. Ngưỡng An toàn Cục bộ của Máy bơm (Hardware Watchdog)
// Bơm không bao giờ được phép chạy liên tục quá số giây này, kể cả khi lệnh yêu cầu nhiều hơn
#define PUMP_MAX_SECONDS      60

// 7. Chu kỳ phát bản tin
#define TELEMETRY_INTERVAL_MS 10000   // 10 giây gửi telemetry 1 lần
#define STATE_HEARTBEAT_MS    15000   // 15 giây gửi state heartbeat 1 lần
#define NTP_SERVER            "pool.ntp.org"

#endif // CONFIG_H
